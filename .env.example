# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# LLM_PROVIDER: gemini | openai-compatible | metamuse
LLM_PROVIDER="metamuse"

# LLM_FALLBACK_PROVIDER: openai-compatible | gemini
LLM_FALLBACK_PROVIDER="openai-compatible"

# LLM_MODEL: model id used by the selected provider.
# Recommended low-cost contributor model:
# muse-spark-1.3-contributor
LLM_MODEL="muse-spark-1.3-contributor"

# LLM_VOICE_MODEL: model id used when mode is set to voice.
# Note: Meta docs indicate audio quality caveats on 1.3; prefer 1.2-contributor for voice-oriented requests.
LLM_VOICE_MODEL="muse-spark-1.2-contributor"

# LLM_MODE: text | voice
LLM_MODE="text"

# LLM_API_KEY: preferred generic provider key (works for both providers).
# For Gemini, GEMINI_API_KEY is also supported for backward compatibility.
LLM_API_KEY=""

# LLM_BASE_URL: required for openai-compatible provider.
# Example: https://api.openai.com/v1 or https://openrouter.ai/api/v1
LLM_BASE_URL=""

# Metamuse primary provider settings.
METAMUSE_API_KEY=""
# If Metamuse uses OpenAI-compatible routing, set its base URL here.
METAMUSE_BASE_URL="https://api.meta.ai/v1"

# OpenAI fallback settings used when Metamuse fails.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"

# Voice policy: OpenAI realtime primary for voice sessions.
OPENAI_VOICE_MODEL="gpt-4o-mini"
OPENAI_REALTIME_MODEL="gpt-4o-realtime-preview"
OPENAI_REALTIME_VOICE="alloy"

# Voice fallback policy: xAI when OpenAI voice path fails.
XAI_API_KEY=""
XAI_BASE_URL="https://api.x.ai/v1"
XAI_VOICE_MODEL="grok-3-mini"

# Optional Ollama Cloud settings for capability-catalog-driven model routing.
OLLAMA_API_KEY=""
OLLAMA_BASE_URL="https://ollama.com/v1"

# Optional system prompt override for chat behavior.
LLM_SYSTEM_PROMPT=""

# Optional path to a prompt/brain file. When set, this takes precedence over
# LLM_SYSTEM_PROMPT and is used for both chat and realtime voice instructions.
# Example:
# LLM_SYSTEM_PROMPT_FILE="/opt/VALERIE_ROUSSEAU_VULPINE_CFO_VOICE_AGENT_BRAIN_INTERNAL_STACK (1).txt"
LLM_SYSTEM_PROMPT_FILE=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# AUTOBIDDER_DATA_DIR: data root for file-backed projects/jobs/uploads.
# On Vercel, default is /tmp/autobidder if this is unset.
# On local/dev, default is .data/autobidder if this is unset.
AUTOBIDDER_DATA_DIR=".data/autobidder"

# VISION_API_TOKEN: Server-to-server token required by active Vision API routes.
# Backoffice sends it only from its server-side proxy as x-vulpine-integration-key.
VISION_API_TOKEN=""

# LEADS_INTEGRATION_KEY: Shared secret for authenticated lead handoff requests.
# Used by POST /api/integrations/leads/handoff via x-integration-key header.
LEADS_INTEGRATION_KEY="replace-with-strong-random-secret"

# Backoffice providers are reported as unavailable until every setting for a
# capability is present. Endpoints must be HTTPS in production.
EMAIL_PROVIDER=""
EMAIL_API_KEY=""
EMAIL_FROM=""
EMAIL_API_ENDPOINT=""

COMPANY_INTELLIGENCE_PROVIDER=""
COMPANY_INTELLIGENCE_API_KEY=""
COMPANY_INTELLIGENCE_ENDPOINT=""

MAPS_PROVIDER=""
MAPS_API_KEY=""
MAPS_ROUTE_ENDPOINT=""
# Optional Cabinet Vision image-analysis provider. Without all four values, image-only pages are
# explicitly marked review-required and only deterministic PDF text classification is used.
CABINET_VISION_PROVIDER=
CABINET_VISION_ENDPOINT=
CABINET_VISION_API_KEY=
CABINET_VISION_MODEL=
